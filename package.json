    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^12.35.2",
    "http-proxy-middleware": "^4.2.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.559.0",
    "mammoth": "^1.12.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.4.1",
    "recharts": "^3.8.1",
